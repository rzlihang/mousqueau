<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="mousqueau"
        Arguments=""
        InstallLocation="C:\Program Files\Mousqueau contributors\Mousqueau">
    </Installer>
    <PackageInformation
        PackageName="Mousqueau"
        PackageDisplayName="Mousqueau"
        PublisherName="CN=Mousqueau contributors"
        PublisherDisplayName="Mousqueau contributors"
        Version="0.1.0.0"
        PackageDescription="A Mousqueau application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.rzlihang.mousqueau"
                Description="A Mousqueau application"
                DisplayName="Mousqueau"
                ExecutableName="mousqueau"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Mousqueau</DisplayName>
            <PublisherDisplayName>Mousqueau contributors</PublisherDisplayName>
            <Description>A Mousqueau application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="mousqueau.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
